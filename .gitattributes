# Fins de ligne LF partout, quel que soit le réglage core.autocrlf du poste (CLAUDE.md §4.7)
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fuzz inputs are raw bytes: never convert their line endings
fuzz/corpus/** -text
fuzz/corpus/README.md text eol=lf
